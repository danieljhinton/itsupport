# --- Server ---
PORT=3000
# Public HTTPS base URL that Twilio can reach (e.g. your ngrok URL, no trailing slash)
PUBLIC_URL=https://example.ngrok-free.app
# Optional: require ?token=... on the dashboard and event stream
DASHBOARD_TOKEN=
# Set to false only for local testing without Twilio signatures
TWILIO_VALIDATE_SIGNATURE=true

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. low keeps voice latency down.
CLAUDE_EFFORT=low

# --- Halo ---
# Halo MCP server endpoint (Streamable HTTP)
HALO_MCP_URL=https://yourinstance.haloitsm.com/mcp
# Halo auth server base URL; the token is fetched from {HALO_AUTH_URL}/token
HALO_AUTH_URL=https://yourinstance.haloitsm.com/auth
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_SCOPE=all
# Only needed for Halo-hosted multi-tenant auth
HALO_TENANT=
# Agent web URL, used for "open in Halo" links on the dashboard
HALO_WEB_URL=https://yourinstance.haloitsm.com
# Tool policy file (which MCP tools Claude may use). See config/tool-policy.json
HALO_TOOL_POLICY=config/tool-policy.json

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Australian number in E.164, e.g. +61280001234
TWILIO_PHONE_NUMBER=
TTS_PROVIDER=Google
TTS_VOICE=en-AU-Neural2-C
TRANSCRIPTION_PROVIDER=Deepgram
WELCOME_GREETING=Hi, you've reached the IT service desk. I'm the virtual assistant. How can I help today?

# --- Branding (used in the prompt) ---
COMPANY_NAME=Contoso
